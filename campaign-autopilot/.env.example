# Environment template for Campaign Autopilot; copy to .env and keep secrets local.

# Required: Supabase project API URL for the agent and scripts.
SUPABASE_URL=
# Required: Supabase service-role key; server only, never expose to the browser.
SUPABASE_SERVICE_KEY=
# Required: Supabase project API URL exposed to the Vite web client (public).
VITE_SUPABASE_URL=
# Required: Supabase publishable/anonymous key exposed to the Vite client.
VITE_SUPABASE_ANON_KEY=
# Required: OpenAI API key for diagnosis and creative generation.
OPENAI_API_KEY=
# Optional: structured-output model override; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Required for real Shopify reads: dev store domain, e.g. brew-bloom.myshopify.com.
SHOPIFY_STORE_DOMAIN=
# Required for real Shopify reads: Dev Dashboard app credentials; server only.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional for hackathon: Meta API token; simulated writes do not need it.
META_ACCESS_TOKEN=
# Optional for hackathon: Meta ad account identifier.
META_AD_ACCOUNT_ID=
# Optional for hackathon: Google Ads developer token.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional for real Google reads: short-lived OAuth access token; do not expose to the browser.
GOOGLE_ADS_ACCESS_TOKEN=
# Optional for real Google reads: target test or approved production customer ID.
GOOGLE_ADS_CUSTOMER_ID=
# Required: agent service address used by server-side scripts; local default below.
AGENT_SERVICE_URL=http://localhost:8000
# Required by the Vite browser client; this value is public.
VITE_AGENT_URL=http://127.0.0.1:8000
# Required for hackathon: simulate ad-platform writes and next-week performance.
SIMULATION_MODE=true

